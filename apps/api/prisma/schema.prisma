// Beekal — data model
// Full rationale in docs/04-data-model-and-rbac.md
//
// Conventions:
//   - UUID v7 primary keys: time-sortable, so they index well. Generated by the
//     client via uuid(7), which needs no database extension and stays portable.
//   - snake_case in Postgres, camelCase in the client.
//   - Soft delete on anything a human authored.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// IDENTITY AND ACCESS
//
// Roles are DATA, not code. A new role is rows, never a migration.
// See docs/04 section 1 for why a users.role enum fails the requirement.
// ============================================================

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum Scope {
  ALL
  OWN
  ASSIGNED
}

model User {
  id            String     @id @default(uuid(7))
  email         String     @unique
  passwordHash  String?    @map("password_hash") // null while an invite is pending
  name          String
  avatarMediaId String?    @map("avatar_media_id")
  status        UserStatus @default(INVITED)
  lastLoginAt   DateTime?  @map("last_login_at")
  mfaSecret     String?    @map("mfa_secret")
  mfaEnabledAt  DateTime?  @map("mfa_enabled_at")
  locale        String     @default("en")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  roles         UserRole[]
  sessions      Session[]
  auditEntries  AuditLog[]
  assignedLeads Lead[]     @relation("LeadAssignee")
  leadNotes     LeadNote[]

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String  @id @default(uuid(7))
  key         String  @unique // 'editor' — stable, referenced by seeds
  name        String // 'Editor' — the editable label
  description String?
  isSystem    Boolean @default(false) @map("is_system") // seeded; deletable only if false
  isOwner     Boolean @default(false) @map("is_owner") // exactly one; protected from lockout

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id       String @id @default(uuid(7))
  key      String @unique // 'case_study:publish'
  resource String // 'case_study'
  action   String // 'publish'
  group    String // 'Content' — drives grouping in the role editor
  label    String
  roles    RolePermission[]

  @@index([group, resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")
  scope        Scope  @default(ALL)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Restrict: a role in use cannot be deleted out from under its holders.
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Session {
  id        String    @id @default(uuid(7))
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") // the raw token is never stored
  ip        String?
  userAgent String?   @map("user_agent")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

// ============================================================
// AUDIT
//
// Append-only. No update or delete permission exists for it in the catalog.
// This is what makes a multi-user admin accountable rather than merely shared.
// ============================================================

model AuditLog {
  id         String   @id @default(uuid(7))
  userId     String?  @map("user_id") // null for system actions
  action     String // 'case_study.publish'
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// LEADS
//
// The form is a qualification instrument, not a contact form (docs/01 s5).
// ============================================================

enum LeadStage {
  NEW
  QUALIFYING
  QUALIFIED
  ASSESSMENT_PROPOSED
  ASSESSMENT_BOOKED
  ASSESSMENT_DELIVERED
  PROJECT_PROPOSED
  WON
  LOST
  NURTURE
  DISQUALIFIED
}

model Lead {
  id          String @id @default(uuid(7))
  name        String
  email       String
  company     String?
  phone       String?
  intent      String // 'assessment' | 'talk'
  problemArea String  @map("problem_area") // the qualifying field
  message     String

  // Two consents, deliberately separate. The privacy copy promises no mailing
  // list, so replying to someone must not enrol them in a sequence. The
  // sequence runner checks marketingConsent. See docs/01 section 6.6.
  contactConsent   Boolean @default(false) @map("contact_consent")
  marketingConsent Boolean @default(false) @map("marketing_consent")

  // Attribution, so a lead's origin survives into the CRM record.
  source      String?
  utmSource   String? @map("utm_source")
  utmMedium   String? @map("utm_medium")
  utmCampaign String? @map("utm_campaign")
  utmContent  String? @map("utm_content")
  utmTerm     String? @map("utm_term")
  referrer    String?
  landingPath String? @map("landing_path")

  // An unexplainable score gets ignored by whoever it was meant to help.
  score        Int   @default(0)
  scoreReasons Json? @map("score_reasons")

  stage        LeadStage @default(NEW)
  assignedToId String?   @map("assigned_to_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  assignedTo User?      @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes      LeadNote[]

  @@index([stage, createdAt])
  @@index([assignedToId, stage])
  @@index([email])
  @@index([deletedAt])
  @@map("leads")
}

model LeadNote {
  id       String @id @default(uuid(7))
  leadId   String @map("lead_id")
  authorId String @map("author_id")
  body     String

  createdAt DateTime @default(now()) @map("created_at")

  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt])
  @@map("lead_notes")
}

// ============================================================
// PLATFORM
// ============================================================

/// Business settings live here, not in the environment, so the founder can
/// change the Assessment price or the reply-time promise without a deploy.
model Setting {
  key       String   @id
  value     Json
  group     String
  label     String
  helpText  String?  @map("help_text")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([group])
  @@map("settings")
}

/// Slug changes write a redirect automatically, so a URL never simply dies.
model Redirect {
  id         String   @id @default(uuid(7))
  fromPath   String   @unique @map("from_path")
  toPath     String   @map("to_path")
  statusCode Int      @default(301) @map("status_code")
  hits       Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("redirects")
}

/// Transactional outbox. Events are written in the same transaction as the
/// state change, then relayed by a worker. Without it, a crash between "lead
/// saved" and "email queued" silently loses a lead (docs/03 section 2).
model OutboxEvent {
  id          String    @id @default(uuid(7))
  type        String
  payload     Json
  processedAt DateTime? @map("processed_at")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([processedAt, createdAt])
  @@map("outbox_events")
}

// ============================================================
// CONTENT
//
// Each type is its own table so queries stay typed and indexable, but all
// share the same publishing shape. Content is data so an Editor can publish
// without a deploy (docs/04 section 2.3).
// ============================================================

enum ContentStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

model Solution {
  id     String @id @default(uuid(7))
  key    String @unique // 'build' | 'modernize' | ...
  slug   String
  locale String @default("en")

  name         String
  cardHeadline String @map("card_headline")
  cardBody     String @map("card_body")
  pageHeadline String @map("page_headline")
  pageIntro    String @map("page_intro")

  signs     Json // string[]
  whatWeDo  Json @map("what_we_do")
  before    Json
  after     Json

  seoTitle       String @map("seo_title")
  seoDescription String @map("seo_description")

  order       Int           @default(0)
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([slug, locale])
  @@index([status, order])
  @@map("solutions")
}

model Problem {
  id     String @id @default(uuid(7))
  key    String @unique
  slug   String
  locale String @default("en")

  cardHeadline String @map("card_headline")
  cardAnswer   String @map("card_answer")
  cardBody     String @map("card_body")
  pageHeadline String @map("page_headline")
  pageIntro    String @map("page_intro")

  diagnostic    Json
  causes        String
  fixLooksLike  Json   @map("fix_looks_like")
  solutionKey   String @map("solution_key")

  seoTitle       String @map("seo_title")
  seoDescription String @map("seo_description")

  order       Int           @default(0)
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([slug, locale])
  @@index([status, order])
  @@map("problems")
}

model CaseStudy {
  id     String @id @default(uuid(7))
  slug   String
  locale String @default("en")

  title       String
  clientName  String? @map("client_name")
  context     String
  solutionKey String  @map("solution_key")
  tabLabel    String  @map("tab_label")

  // The eight-part format. `lesson` is mandatory: it is the most credible
  // element on the site precisely because nobody fakes one.
  problem     String
  beforeLead  String @map("before_lead")
  before      String
  diagnosis   String
  whatChanged String @map("what_changed")
  howBuilt    String @map("how_built")
  results     Json
  lesson      String

  /// Drives the "Example scenario" badge automatically. A database constraint
  /// (below) makes it impossible to claim a case is real without a named,
  /// approved client.
  isIllustrative Boolean   @default(true) @map("is_illustrative")
  clientApproved Boolean   @default(false) @map("client_approved")
  approvedAt     DateTime? @map("approved_at")
  approvedBy     String?   @map("approved_by")

  featured Boolean @default(false)
  order    Int     @default(0)

  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([slug, locale])
  @@index([status, featured, order])
  @@map("case_studies")
}

model Faq {
  id     String @id @default(uuid(7))
  locale String @default("en")

  question String
  answer   String
  group    String // 'assessment' — drives placement and the JSON-LD

  order       Int           @default(0)
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([group, order])
  @@map("faqs")
}

model Media {
  id         String @id @default(uuid(7))
  storageKey String @unique @map("storage_key")
  filename   String
  mimeType   String @map("mime_type")
  bytes      Int
  width      Int?
  height     Int?

  /// Nullable in storage, but REQUIRED by the publish validator. An image
  /// without alt text cannot go live (docs/04 section 2.3).
  altText  String? @map("alt_text")
  blurhash String?
  variants Json?

  uploadedById String   @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")

  @@index([deletedAt, createdAt])
  @@map("media")
}

// ============================================================
// MATURITY SCORE
// ============================================================

/// The nine sliders. In the database because the model WILL change, and a
/// scoring model hard-coded in a component is one nobody improves.
model ScoreDimension {
  id       String  @id @default(uuid(7))
  key      String  @unique
  label    String
  question String
  helpText String? @map("help_text")
  /// Level 1..5 wording, so a slider position means something specific.
  anchors  Json
  weight   Float   @default(1)
  order    Int     @default(0)
  active   Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([active, order])
  @@map("score_dimensions")
}

model ScoreLevel {
  level       Int    @id
  name        String
  description String
  guidance    String

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("score_levels")
}

model ScoreSubmission {
  id String @id @default(uuid(7))

  /// Short code so a COO can send their result to the CEO. That sharing is
  /// distribution the demo's version could not do.
  shareCode String @unique @map("share_code")

  answers    Json
  totalScore Float    @map("total_score")
  level      Int
  weakest    String[]

  /// Only set if they asked for the PDF. The score itself needs no email.
  email  String?
  leadId String? @map("lead_id")

  utmSource   String? @map("utm_source")
  utmMedium   String? @map("utm_medium")
  utmCampaign String? @map("utm_campaign")
  referrer    String?

  completedAt DateTime @default(now()) @map("completed_at")

  @@index([level, completedAt])
  @@index([email])
  @@map("score_submissions")
}
