# Beekal — environment template
#
# Copy to .env and fill in. Never commit .env.
# Business settings (Assessment price, contact email, reply-time promise) are
# NOT here — they live in the database so they can change without a deploy.
# See docs/03-system-architecture.md section 7.

# --- Core ---
NODE_ENV=development
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

WEB_PORT=3000
API_PORT=4000

# --- Database ---
POSTGRES_USER=beekal
POSTGRES_PASSWORD=beekal_dev_password
POSTGRES_DB=beekal
POSTGRES_PORT=5432
# Used by Prisma when running outside Docker (migrations, studio, seed):
DATABASE_URL=postgresql://beekal:beekal_dev_password@localhost:5432/beekal

# --- Cache / queue ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Sessions ---
# Generate with: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_generate_a_real_secret_at_least_32_characters_long
SESSION_TTL_HOURS=12
SESSION_COOKIE_NAME=bk_session

# --- Storage (port: s3 | local). Default adapter is self-hosted MinIO. ---
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=beekal-media
S3_ACCESS_KEY=beekal_minio
S3_SECRET_KEY=beekal_minio_dev_password
S3_PUBLIC_URL=http://localhost:9000/beekal-media
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Email (port: smtp | resend | ses | console) ---
# 'console' prints emails to the log instead of sending. Correct for local dev.
MAIL_DRIVER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Beekal <hello@beekal.com>
MAIL_REPLY_TO=shakil@beekal.com

# --- AI (port: none | openai-compatible | anthropic | ollama) ---
# Deliberately off. Master prompt section 17: do not add AI because it is
# fashionable. The port exists; the adapter stays off until a feature needs it.
AI_DRIVER=none
AI_API_KEY=
AI_MODEL=

# --- Analytics (self-hosted Umami, cookie-free) ---
# Shares the Postgres instance but uses its own database.
UMAMI_DB=umami
UMAMI_PORT=3001
# Generate with: openssl rand -base64 32
UMAMI_SECRET=CHANGE_ME_generate_a_real_secret
# Set once Umami gives you a website id, then the site starts sending events.
NEXT_PUBLIC_UMAMI_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- Content revalidation ---
# When content is published the API tells the web app to drop its cache for
# that type, so the change is live immediately instead of within the 5-minute
# backstop. Optional: leave both empty and publishing still works, just not
# instantly.
# Generate with: openssl rand -base64 32
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=

# --- Observability ---
LOG_LEVEL=debug
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# --- Security ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# How many reverse proxies sit in front of the API.
# Rate limiting counts per client IP. Behind a proxy every request appears to
# come FROM the proxy, so the whole site shares one counter unless this is set.
# Use the number of proxies you actually operate - 1 for a single Caddy in
# front. 0 (trust nothing) is correct for local development, because a
# forwarded header nobody set is a header anyone can forge.
TRUST_PROXY_HOPS=0

# --- Seeding ---
# The Owner account is created with a one-time setup link, never a password.
SEED_OWNER_EMAIL=shakil@beekal.com
SEED_OWNER_NAME=Shakil Mahmud
