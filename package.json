{
  "name": "beekal",
  "version": "0.1.0",
  "private": true,
  "description": "Beekal \u2014 website, admin panel and business spine",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:int": "turbo run test:int",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,yml,yaml}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @beekal/api db:generate",
    "db:migrate": "pnpm --filter @beekal/api db:migrate",
    "db:seed": "pnpm --filter @beekal/api db:seed",
    "db:studio": "pnpm --filter @beekal/api db:studio",
    "docker:up": "docker compose --env-file .env -f infra/docker/compose.yml up -d",
    "docker:down": "docker compose --env-file .env -f infra/docker/compose.yml down",
    "docker:logs": "docker compose --env-file .env -f infra/docker/compose.yml logs -f",
    "docker:reset": "docker compose --env-file .env -f infra/docker/compose.yml down -v",
    "docker:ps": "docker compose --env-file .env -f infra/docker/compose.yml ps",
    "docker:build": "docker compose --env-file .env -f infra/docker/compose.yml build",
    "test:e2e": "turbo run test:e2e",
    "test:a11y": "turbo run test:a11y"
  },
  "devDependencies": {
    "@beekal/config": "workspace:*",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
