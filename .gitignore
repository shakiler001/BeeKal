# --- Dependencies ---
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# --- Build output ---
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo
next-env.d.ts

# --- Environment and secrets ---
# .env.example IS committed; everything else never is.
.env
.env.*
!.env.example
*.pem
*.key
!infra/**/*.example.key

# --- Test and coverage ---
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
.playwright/

# --- Prisma ---
prisma/*.db
prisma/*.db-journal

# --- Logs ---
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Editor / OS ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json

# --- Local infrastructure state ---
infra/docker/data/
infra/docker/.env
*.local

