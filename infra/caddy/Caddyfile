# Beekal — reverse proxy, TLS and security headers.
#
# Caddy is here rather than nginx for one reason: it obtains and renews
# certificates on its own, with no cron job to forget. One fewer thing that can
# silently expire at 2am on a Saturday.

{
	email {$ACME_EMAIL}
	# Keep the admin API off the network entirely; nothing needs it.
	admin off
}

{$SITE_DOMAIN} {
	encode zstd gzip

	header {
		# HSTS. Only once the domain is confirmed and serving over TLS — turning
		# this on early pins a mistake into browsers for a year.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"

		# Content Security Policy.
		#
		# 'unsafe-inline' on script-src is the one concession, and it is there
		# for exactly one script: the pre-paint theme setter in the root layout,
		# which MUST run inline or the page flashes light before going dark.
		# Replacing it with a nonce is a Phase 7 task — Next's own inline
		# bootstrap would need one too, so it is all-or-nothing.
		#
		# Everything else is locked to self. Fonts are self-hosted, the sprite is
		# inline, and analytics is on our own domain, so there is no third-party
		# origin to allow.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"

		# Do not advertise what we are running.
		-Server
		-X-Powered-By
	}

	# The API. Next's BFF routes call this internally, but the browser reaches
	# /api directly for the public form so the same-origin cookie works.
	handle /api/* {
		reverse_proxy api:4000
	}

	handle /health* {
		reverse_proxy api:4000
	}

	# Hashed build assets never change, so they can be cached forever.
	@immutable path /_next/static/* /fonts/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# The admin is never cached anywhere, by anyone.
	@admin path /admin /admin/*
	header @admin {
		Cache-Control "no-store, must-revalidate"
		X-Robots-Tag "noindex, nofollow"
	}

	handle {
		reverse_proxy web:3000
	}
}

# Analytics on its own subdomain, so a cookie set there can never reach the app.
analytics.{$SITE_DOMAIN} {
	encode zstd gzip
	reverse_proxy umami:3000
}
